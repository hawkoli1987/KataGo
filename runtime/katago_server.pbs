#!/bin/bash
#PBS -N katago_server
#PBS -q AISG_debug
#PBS -l walltime=48:00:00
#PBS -l select=1:mem=200gb:ncpus=32:ngpus=1
#PBS -j oe
#PBS -o /dev/null
#PBS -W umask=0007

# =============================================================================
# KataGo Analysis Server (single- or multi-GPU)
# =============================================================================
# Starts one HTTP analysis server backed by N KataGo subprocess workers, each
# pinned to a different GPU. The server's least-loaded router balances requests
# across workers internally. Set NUM_WORKERS or it auto-detects from the
# GPUs visible to the job (nvidia-smi -L).
#
# Default header reserves 1 GPU (suitable for `manage_servers.sh` which
# manages lightweight reference/candidate servers). For high-throughput data
# generation, override the resource line on the qsub command line:
#
#   # 8-GPU server for offline analysis (gives ~47 q/s with C=256 client)
#   qsub -l select=1:mem=400gb:ncpus=64:ngpus=8 \
#        -v MODEL_PATH=/path/to/model.bin.gz \
#        runtime/katago_server.pbs
#
#   # Single GPU (default header is fine)
#   qsub -v MODEL_PATH=/path/to/model.bin.gz runtime/katago_server.pbs
#
# Throughput note: the in-process StreamReader buffer was raised to 4 MB in
# analysis_server.py (bugs.md 2026-05-14) to prevent a flow-control deadlock
# at high in_flight. Client should use --max-concurrent ~32 per worker to
# saturate the GPUs.
#
# Environment variables (set via qsub -v):
#   MODEL_PATH    Path to KataGo model weights (required)
#   SERVER_PORT   HTTP port (default: 9200)
#   SERVER_NAME   Label for logs (default: katago)
#   NUM_WORKERS   KataGo subprocesses (default: auto-detect from nvidia-smi -L)
# =============================================================================

set -euo pipefail

# --- Configuration ---
MODEL_PATH="${MODEL_PATH:?ERROR: MODEL_PATH environment variable is required}"
SERVER_PORT="${SERVER_PORT:-9200}"
SERVER_NAME="${SERVER_NAME:-katago}"
NUM_WORKERS="${NUM_WORKERS:-$(nvidia-smi -L 2>/dev/null | wc -l || echo 1)}"
[ "${NUM_WORKERS}" -ge 1 ] || NUM_WORKERS=1

REPO_DIR="/scratch/Projects/SPEC-SF-AISG/source_files/KataGo"
SHARED_FS="/scratch/Projects/SPEC-SF-AISG"
SHARED_FS2="/scratch_aisg/SPEC-SF-AISG"
SQSH_FILE="${SHARED_FS}/sqsh/go.sqsh"
CONTAINER_NAME="katago_dev"

# Enroot paths (all on scratch, never $HOME)
ENROOT_CACHE_ROOT="/scratch_aisg/SPEC-SF-AISG/yuli/workdir/shared_fs/cache/.enroot"
export ENROOT_DATA_PATH="${ENROOT_CACHE_ROOT}"
export ENROOT_RUNTIME_PATH="${ENROOT_CACHE_ROOT}/runtime"
export XDG_DATA_HOME="/scratch_aisg/SPEC-SF-AISG/yuli/workdir/shared_fs/cache/xdg"
export XDG_CACHE_HOME="/scratch_aisg/SPEC-SF-AISG/yuli/workdir/shared_fs/cache/xdg_cache"

HOST_NVIDIA_MOUNT="/opt/host-nvidia"
HOST_LIBCUDA="/lib64/libcuda.so.1"
HOST_LIBNVML="/lib64/libnvidia-ml.so.1"

# --- Logging ---
LOG_DIR="${REPO_DIR}/runtime/log/${PBS_JOBID}"
mkdir -p "${LOG_DIR}"
exec >> "${LOG_DIR}/pbs.log" 2>&1

echo "=== ${SERVER_NAME} server started at $(date) ==="
echo "PBS_JOBID:    ${PBS_JOBID}"
echo "Hostname:     $(hostname)"
echo "MODEL_PATH:   ${MODEL_PATH}"
echo "SERVER_PORT:  ${SERVER_PORT}"
echo "NUM_WORKERS:  ${NUM_WORKERS}"

mkdir -p "${ENROOT_DATA_PATH}"

# --- Resolve model path (relative to repo root if not absolute) ---
if [[ "${MODEL_PATH}" != /* ]]; then
    FULL_MODEL_PATH="${REPO_DIR}/${MODEL_PATH}"
else
    FULL_MODEL_PATH="${MODEL_PATH}"
fi

# --- Verify prerequisites ---
[ -f "${SQSH_FILE}" ]        || { echo "ERROR: missing ${SQSH_FILE}"; exit 1; }
[ -f "${FULL_MODEL_PATH}" ]  || { echo "ERROR: missing ${FULL_MODEL_PATH}"; exit 1; }
[ -f "${HOST_LIBCUDA}" ]     || { echo "ERROR: missing ${HOST_LIBCUDA}"; exit 1; }

echo "SQSH file:    ${SQSH_FILE} [OK]"
echo "Model file:   ${FULL_MODEL_PATH} [OK]"
echo "libcuda:      ${HOST_LIBCUDA} [OK]"
echo "libnvml:      ${HOST_LIBNVML} [$([ -f ${HOST_LIBNVML} ] && echo OK || echo MISSING)]"

export LD_LIBRARY_PATH="${HOST_NVIDIA_MOUNT}:${LD_LIBRARY_PATH:-}"

# --- Container setup ---
if ! enroot list | grep -q "^${CONTAINER_NAME}$"; then
    echo "Creating container ${CONTAINER_NAME}..."
    enroot create -n "${CONTAINER_NAME}" "${SQSH_FILE}"
fi

echo "Preparing container mount points..."
enroot start --root --rw \
    --mount="${SHARED_FS}:${SHARED_FS}" \
    --mount="${SHARED_FS2}:${SHARED_FS2}" \
  "${CONTAINER_NAME}" \
  /bin/bash -lc "mkdir -p ${HOST_NVIDIA_MOUNT}"

# --- Background monitors ---
# GPU monitor — samples every 5s for all visible GPUs
nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total,power.draw \
  --format=csv -l 5 > "${LOG_DIR}/gpu.log" 2>&1 &
echo "GPU monitor PID: $!"

# Node-wide CPU/memory monitor
( while true; do
    echo "=== $(date) ==="
    vmstat 1 2 | tail -1
    sleep 5
  done ) > "${LOG_DIR}/cpu.log" 2>&1 &
echo "CPU monitor PID: $!"

# --- Launch server ---
echo "Launching analysis server on port ${SERVER_PORT} with ${NUM_WORKERS} worker(s)..."
enroot start --root --rw \
    --env LD_LIBRARY_PATH \
    --env "MODEL_PATH=${FULL_MODEL_PATH}" \
    --env "NUM_WORKERS=${NUM_WORKERS}" \
    --mount="${SHARED_FS}:${SHARED_FS}" \
    --mount="${SHARED_FS2}:${SHARED_FS2}" \
    --mount="${HOST_LIBCUDA}:${HOST_NVIDIA_MOUNT}/libcuda.so.1" \
    --mount="${HOST_LIBNVML}:${HOST_NVIDIA_MOUNT}/libnvidia-ml.so.1" \
    --mount="/usr/bin/nvidia-smi:/usr/bin/nvidia-smi" \
  "${CONTAINER_NAME}" \
  /bin/bash -lc "cd ${REPO_DIR} && uvicorn runtime.analysis_server:app --host 0.0.0.0 --port ${SERVER_PORT} --log-level warning"

echo "=== ${SERVER_NAME} server exited at $(date) ==="
