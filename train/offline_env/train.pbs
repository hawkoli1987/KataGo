#!/bin/bash

#PBS -N verl_train
#PBS -q AISG_large
#PBS -l select=2:ngpus=8:ncpus=100:mem=1500gb
#PBS -l walltime=24:00:00
#PBS -o /dev/null
#PBS -e /dev/null

set -euo pipefail

module load nccl
module load openmpi4/gcc/4.1.5
module load singularity

# ============================================================================
# Job metadata (PBS-specific, must be set here)
# ============================================================================
export JOB_WORK_DIR="${PBS_O_WORKDIR}"
export JOB_ID="$(echo "${PBS_JOBID}" | cut -d'.' -f1)"
export JOB_NAME="${PBS_JOBNAME}"
SCRIPT_DIR="${JOB_WORK_DIR}"

# ============================================================================
# Filesystem paths (needed for bind mounts and log directory)
# ============================================================================
export SHARED_FS="/scratch_aisg/SPEC-SF-AISG"
export SHARED_FS2="/scratch/Projects/SPEC-SF-AISG"

# ============================================================================
# Algorithm: GRPO (align with hopper_verl baseline)
# ============================================================================
export ALGO="grpo"

# ============================================================================
# Experiment configuration (baseline tuned for 2x H200)
# Override on submission: qsub -v MODEL_PATH=...,TRAIN_BATCH_SIZE=... train.pbs
# ============================================================================
# Model
export MODEL_PATH="${MODEL_PATH:-Qwen/Qwen3-4B}"
export TRAIN_BATCH_SIZE="${TRAIN_BATCH_SIZE:-512}"        # GBS
export MAX_PROMPT_LENGTH="${MAX_PROMPT_LENGTH:-4096}"      # increased: some prompts tokenize to 2285+ tokens
export MAX_RESPONSE_LENGTH="${MAX_RESPONSE_LENGTH:-8192}"  # keep 8k

# Actor (Megatron TP=4)
export ACTOR_STRATEGY="${ACTOR_STRATEGY:-megatron}"
export ACTOR_TP_SIZE="${ACTOR_TP_SIZE:-4}"
export ACTOR_PP_SIZE="${ACTOR_PP_SIZE:-1}"
export ACTOR_MICRO_BS="${ACTOR_MICRO_BS:-8}"
export ACTOR_MINI_BS="${ACTOR_MINI_BS:-512}"
export ACTOR_LR="${ACTOR_LR:-1e-6}"
export ACTIVATION_OFFLOAD="${ACTIVATION_OFFLOAD:-False}"

# GRPO Group Sampling
export ROLLOUT_N="${ROLLOUT_N:-16}"

# Generation (vLLM)
export GPU_MEMORY_UTIL="${GPU_MEMORY_UTIL:-0.90}"
export ROLLOUT_LOG_PROB_BS="${ROLLOUT_LOG_PROB_BS:-4}"
export ROLLOUT_TP_SIZE="${ROLLOUT_TP_SIZE:-1}"
export ROLLOUT_QUANTIZATION="${ROLLOUT_QUANTIZATION:-}"
export ENFORCE_EAGER="${ENFORCE_EAGER:-False}"

# Reference
export REF_LOG_PROB_BS="${REF_LOG_PROB_BS:-4}"

# Training
export TOTAL_EPOCHS="${TOTAL_EPOCHS:-15}"
export TOTAL_STEPS="${TOTAL_STEPS:-0}"     # 0 = use epochs
export SAVE_FREQ="${SAVE_FREQ:-60}"
export TEST_FREQ="${TEST_FREQ:-7}"

# ============================================================================
# Log directory (must be created before container launch)
# ============================================================================
export LOG_DIR="${SHARED_FS}/log/go/${SWEEP_NAME:-}/${JOB_NAME}/${JOB_ID}"

umask 0007
mkdir -p "${LOG_DIR}/nccl"
mkdir -p "${LOG_DIR}/env"

# Send all stdout/stderr to LOG_DIR
exec > >(tee -a "${LOG_DIR}/pbs.out") 2> >(tee -a "${LOG_DIR}/pbs.err" >&2)

cd "${JOB_WORK_DIR}"

# Save host env for debugging
printenv | sort > "${LOG_DIR}/env/EnvVar_hostOS.log"

# ============================================================================
# Cluster topology
# ============================================================================
readarray -t host_array < <(sort -u "${PBS_NODEFILE}")
NUM_NODES=${#host_array[@]}
MASTER_ADDR="${host_array[0]}"
HOSTFILE_UNIQUE="${LOG_DIR}/hostfile"
printf "%s\n" "${host_array[@]}" > "${HOSTFILE_UNIQUE}"

GPUS_PER_NODE="$(nvidia-smi -L | wc -l)"
WORLD_SIZE=$((GPUS_PER_NODE * NUM_NODES))
MASTER_PORT=$((10000 + RANDOM % 10000))

# ============================================================================
# Container setup
# ============================================================================
SIF_PATH="${SHARED_FS}/sif/verl-vllm012.sif"

# Copy scripts to log dir for reproducibility
cp "${SCRIPT_DIR}/train/offline_env/train.pbs" "${LOG_DIR}/train.pbs"
cp "${SCRIPT_DIR}/train/offline_env/train.sh" "${LOG_DIR}/train.sh"
cp "${SCRIPT_DIR}/train/offline_env/reward.py" "${LOG_DIR}/reward.py"
# Copy configs dir for reward.py (it looks for configs/config.yaml relative to its parent)
cp -r "${SCRIPT_DIR}/configs" "${LOG_DIR}/configs"
chmod +rx "${LOG_DIR}"/*

BASH_SCRIPT="${LOG_DIR}/train.sh"

# ============================================================================
# Launch command
# ============================================================================
launch_cmd="singularity exec --nv \
    --bind ${SHARED_FS}:${SHARED_FS} \
    --bind ${SHARED_FS2}:${SHARED_FS2} \
    --bind ${HOME}:${HOME} \
    ${SIF_PATH} \
    bash ${BASH_SCRIPT} \
        ${GPUS_PER_NODE} \
        ${WORLD_SIZE} \
        ${NUM_NODES} \
        ${MASTER_ADDR} \
        ${MASTER_PORT} \
        \${OMPI_COMM_WORLD_RANK}"

# Only pass essential env vars that are PBS-specific
# All other env vars are defined directly in train.sh
mpirun -np "${NUM_NODES}" \
    --hostfile "${HOSTFILE_UNIQUE}" \
    --map-by ppr:1:node \
    -x LOG_DIR \
    -x JOB_ID \
    -x JOB_NAME \
    -x SHARED_FS \
    -x SHARED_FS2 \
    -x ALGO \
    -x MODEL_PATH \
    -x TRAIN_BATCH_SIZE \
    -x MAX_PROMPT_LENGTH \
    -x MAX_RESPONSE_LENGTH \
    -x GPU_MEMORY_UTIL \
    -x ROLLOUT_LOG_PROB_BS \
    -x ROLLOUT_TP_SIZE \
    -x ROLLOUT_N \
    -x ROLLOUT_QUANTIZATION \
    -x ENFORCE_EAGER \
    -x REF_LOG_PROB_BS \
    -x ACTOR_MICRO_BS \
    -x ACTOR_MINI_BS \
    -x ACTOR_LR \
    -x ACTIVATION_OFFLOAD \
    -x ACTOR_STRATEGY \
    -x ACTOR_TP_SIZE \
    -x ACTOR_PP_SIZE \
    -x TOTAL_EPOCHS \
    -x TOTAL_STEPS \
    -x SAVE_FREQ \
    -x TEST_FREQ \
    bash -c "${launch_cmd}"
